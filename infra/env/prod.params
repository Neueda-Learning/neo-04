# neo-04's OWN service (module 01: Fraud & AML Screening), on prod. Identical to
# dev.params — a module carries no environment-specific values (the orchestrator URL is built
# from the Cloud Map namespace in the template). The pipeline adds EnvironmentName + the
# PINNED @sha256 images + DbEndpoint + AlbDnsName.
ServiceName=neo-04
Role=module
PathPrefix=/neo-04
ListenerRulePriority=40
DbName=neo_04
ServiceId=neo04
DisplayName=Fraud & AML Screening
Domain=screening
Team=Team 04
MockedDependencies=sanctions-list
